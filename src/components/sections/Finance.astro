---
import Section from '../Section.astro';
import { supabase } from '@lib/supabase';

const { data: subs, error } = await supabase
  .from('subscriptions')
  .select('id, service_name, amount_eur, amount_usd, billing_cycle, status, category, notes')
  .eq('status', 'active')
  .order('amount_usd', { ascending: false, nullsFirst: false });

const paid = (subs || []).filter(s => (s.amount_usd || s.amount_eur || 0) > 0);
const free = (subs || []).filter(s => !(s.amount_usd || s.amount_eur || 0));

const totalMonthlyUsd = paid
  .filter(s => s.billing_cycle === 'monthly')
  .reduce((sum, s) => sum + (s.amount_usd || (s.amount_eur ? s.amount_eur * 1.08 : 0)), 0);

const totalMonthlyEur = paid
  .filter(s => s.billing_cycle === 'monthly')
  .reduce((sum, s) => sum + (s.amount_eur || 0), 0);
---
<Section title="Subscriptions & Finance" icon="💸" badge={paid.length} badgeColor="yellow">
  {error && <p class="text-xs text-accent-red">Supabase error: {error.message}</p>}

  {paid.length > 0 && (
    <div class="text-xs text-gray-400 mb-3 flex gap-3">
      {totalMonthlyUsd > 0 && (
        <span>USD: <span class="font-mono text-gray-200">${totalMonthlyUsd.toFixed(0)}/mo</span></span>
      )}
      {totalMonthlyEur > 0 && (
        <span>EUR: <span class="font-mono text-gray-200">€{totalMonthlyEur.toFixed(0)}/mo</span></span>
      )}
    </div>
  )}

  {(!subs || subs.length === 0) && !error && (
    <p class="text-sm text-gray-500 italic">No subscriptions tracked.</p>
  )}

  {paid.length > 0 && (
    <ul class="space-y-1.5 text-sm mb-3">
      {paid.map(s => (
        <li class="flex items-start justify-between gap-2">
          <div class="flex-1 min-w-0">
            <p class="truncate">{s.service_name}</p>
            {s.category && <p class="text-xs text-gray-600">{s.category}</p>}
          </div>
          <p class="font-mono text-xs shrink-0 text-gray-300">
            {s.amount_usd ? `$${s.amount_usd}` : s.amount_eur ? `€${s.amount_eur}` : '—'}
            /{s.billing_cycle?.[0] ?? '?'}
          </p>
        </li>
      ))}
    </ul>
  )}

  {free.length > 0 && (
    <div>
      <p class="text-xs uppercase tracking-wider text-gray-600 mb-1">Free tier</p>
      <p class="text-xs text-gray-500">{free.map(s => s.service_name).join(' · ')}</p>
    </div>
  )}
</Section>
