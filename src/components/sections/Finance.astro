---
import Section from '../Section.astro';
import { supabase } from '@lib/supabase';

const { data: subs, error } = await supabase
  .from('subscriptions')
  .select('id, service_name, vendor, amount_eur, amount_usd, billing_cycle, status, category, total_paid, notes')
  .eq('status', 'active')
  .order('amount_usd', { ascending: false, nullsFirst: false });

const totalMonthlyUsd = (subs || [])
  .filter(s => s.billing_cycle === 'monthly')
  .reduce((sum, s) => sum + (s.amount_usd || 0), 0);
---
<Section title="Subscriptions & Finance" icon="💸" badge={subs?.length || 0} badgeColor="yellow">
  {error && <p class="text-xs text-accent-red">Supabase error: {error.message}</p>}

  {totalMonthlyUsd > 0 && (
    <div class="text-xs text-gray-400 mb-3">
      Monthly recurring: <span class="font-mono text-gray-200">${totalMonthlyUsd.toFixed(2)}/mo</span>
    </div>
  )}

  {(!subs || subs.length === 0) && !error && (
    <p class="text-sm text-gray-500 italic">No subscriptions tracked. Wire Gmail parser to auto-detect.</p>
  )}

  {subs && subs.length > 0 && (
    <ul class="space-y-2 text-sm">
      {subs.map(s => (
        <li class="flex items-start justify-between gap-2 border-b border-bg-border/50 last:border-0 pb-2 last:pb-0">
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate">{s.service_name}</p>
            {s.notes && <p class="text-xs text-gray-500 line-clamp-1">{s.notes}</p>}
          </div>
          <div class="text-right shrink-0">
            <p class="font-mono text-xs">
              ${s.amount_usd?.toFixed(2)}/{s.billing_cycle?.[0]}
            </p>
            {s.total_paid && (
              <p class="text-xs text-gray-500">total ${s.total_paid.toFixed(2)}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</Section>
