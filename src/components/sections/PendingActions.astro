---
import Section from '../Section.astro';
import { serverClient, MISSING_SERVICE_KEY } from '@lib/supabase';

const supabase = serverClient(Astro.locals);
const { data: actions, error } = supabase
  ? await supabase
      .from('pending_actions')
      .select('id, source, action_type, payload, status, notes, created_at')
      .eq('status', 'pending')
      .order('created_at', { ascending: false })
      .limit(10)
  : { data: null, error: MISSING_SERVICE_KEY };

const sourceIcon: Record<string, string> = {
  dashboard: '🖥️',
  claude_mobile: '📱',
  mobile_voice: '🎙️',
  pwa: '📲',
  manual: '✋',
};
---
<Section title="Pending Actions" icon="⏳" badge={actions?.length || 0} badgeColor={actions && actions.length > 0 ? 'yellow' : 'green'}>
  {error && <p class="text-xs text-accent-red">Supabase error: {error.message}</p>}

  {(!actions || actions.length === 0) && !error && (
    <p class="text-sm text-gray-500 italic">No pending actions. Mobile-to-VSC bridge clean.</p>
  )}

  {actions && actions.length > 0 && (
    <ul class="space-y-2 text-sm">
      {actions.map(a => (
        <li class="flex items-start gap-2 border-b border-bg-border/50 last:border-0 pb-2 last:pb-0">
          <span class="shrink-0">{sourceIcon[a.source] || '?'}</span>
          <div class="flex-1 min-w-0">
            <p class="font-medium">{a.action_type}</p>
            {a.notes && <p class="text-xs text-gray-500 line-clamp-2">{a.notes}</p>}
            <p class="text-xs text-gray-600 mt-1">from {a.source} · {new Date(a.created_at).toLocaleString('sr-Latn', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}</p>
          </div>
          <form method="POST" action="/api/actions/done" class="shrink-0">
            <input type="hidden" name="id" value={a.id} />
            <button type="submit" class="text-xs px-2 py-0.5 rounded border bg-green-950/40 text-green-400 border-green-800/40 hover:bg-green-900/60 transition-colors">
              Done ✓
            </button>
          </form>
        </li>
      ))}
    </ul>
  )}
</Section>
