---
import Section from '../Section.astro';
import { supabase } from '@lib/supabase';

// Checked 2026-05-31 — n8n version-check cron updates current/latest daily
const services = [
  { name: 'Claude Code (WSL)', icon: '🤖', current: '2.1.150', latest: '2.1.150', status: 'up',  upgrade: null, note: 'Run: sudo npm update -g @anthropic-ai/claude-code' },
  { name: 'Claude Code (VPS)', icon: '🤖', current: '2.1.150', latest: '2.1.150', status: 'up',  upgrade: null, note: 'claude update on VPS' },
  { name: 'n8n',               icon: '🔄', current: '2.22.5',  latest: '2.22.5',  status: 'up',  upgrade: null, note: '11 workflows · systemd service' },
  { name: 'LiteLLM proxy',     icon: '🧠', current: 'main-stable', latest: null,  status: 'up',  upgrade: 'docker pull ghcr.io/berriai/litellm:main-stable && docker compose -f /root/litellm/docker-compose.yml up -d', note: '3-tier fallback · per-agent $30/mo cap' },
  { name: 'Langfuse v3',       icon: '📊', current: '3.175.0', latest: '3.175.0', status: 'up',  upgrade: null, note: 'All LLM traces + cost/latency' },
  { name: 'Uptime Kuma',       icon: '🩺', current: '2.x',     latest: null,      status: 'up',  upgrade: null, note: 'Monitors OpenClaw + GeoBIM · Telegram alerts' },
  { name: 'Coolify',           icon: '🚢', current: '4.1.0',   latest: null,      status: 'up',  upgrade: null, note: 'Self-updates via UI · 4 containers healthy' },
  { name: 'Monica CRM',        icon: '👥', current: 'latest',  latest: null,      status: 'up',  upgrade: 'docker compose -f /opt/monica/docker-compose.yml pull && docker compose up -d', note: 'Self-hosted CRM · monica.ulcinno.me' },
  { name: 'Miniflux RSS',      icon: '📰', current: 'latest',  latest: null,      status: 'up',  upgrade: 'docker compose -f /opt/miniflux/docker-compose.yml pull && docker compose up -d', note: 'miniflux.ulcinno.me' },
  { name: 'Karakeep',          icon: '🔖', current: 'release', latest: null,      status: 'up',  upgrade: 'docker compose -f /opt/karakeep/docker-compose.yml pull && docker compose up -d', note: 'karakeep.ulcinno.me' },
  { name: 'Supabase KB',       icon: '🗄️', current: 'managed', latest: null,      status: 'up',  upgrade: null, note: 'Auto-updated by Supabase · 60+ tables' },
  { name: 'Firecrawl Hobby',   icon: '🔥', current: 'SaaS',    latest: null,      status: 'up',  upgrade: null, note: '3K credits/mo' },
  { name: 'Better Stack',      icon: '⬆️', current: 'SaaS',    latest: null,      status: 'up',  upgrade: null, note: 'GeoBIM uptime + incident alerts' },
];

const needsUpdate = services.filter(s => s.latest && s.current !== s.latest && s.upgrade && !s.upgrade.startsWith('MAJOR'));
const majorUpdate = services.filter(s => s.upgrade?.startsWith('MAJOR'));

const statusDot = (s: string) =>
  s === 'up' ? '🟢' : s === 'warn' ? '🟡' : '🔴';

function versionBadge(current: string, latest: string | null) {
  if (!latest || current === latest || current === 'latest' || current === 'managed' || current === 'SaaS' || current === 'release') return null;
  if (latest && current !== latest) return latest;
  return null;
}
---
<Section
  title="System Health"
  icon="⚙️"
  badge={needsUpdate.length + majorUpdate.length}
  badgeColor={needsUpdate.length + majorUpdate.length > 0 ? 'yellow' : 'green'}
>
  {(needsUpdate.length + majorUpdate.length) > 0 && (
    <div class="mb-3 text-xs text-yellow-400 border border-yellow-800/30 bg-yellow-950/20 rounded-lg px-3 py-2">
      {needsUpdate.length} update{needsUpdate.length !== 1 ? 's' : ''} available
      {majorUpdate.length > 0 && ` · ${majorUpdate.length} major (manual)`}
    </div>
  )}

  <ul class="space-y-2 text-sm">
    {services.map(s => {
      const badge = versionBadge(s.current, s.latest);
      const isMajor = s.upgrade?.startsWith('MAJOR');
      return (
        <li class="border-b border-gray-800/40 last:border-0 pb-2 last:pb-0">
          <div class="flex items-center gap-2">
            <span class="shrink-0">{s.icon}</span>
            <span class="font-medium flex-1 min-w-0 truncate">{s.name}</span>
            <span class="font-mono text-xs text-gray-600">{s.current}</span>
            {badge && (
              <span class={`text-xs px-1.5 py-0.5 rounded border shrink-0 ${isMajor ? 'text-red-400 border-red-800/40 bg-red-950/30' : 'text-yellow-400 border-yellow-800/40 bg-yellow-950/30'}`}>
                →{badge}
              </span>
            )}
            <span class="shrink-0 text-xs">{statusDot(s.status)}</span>
          </div>
          {s.note && <p class="text-xs text-gray-600 ml-6 mt-0.5 line-clamp-1">{s.note}</p>}
          {badge && s.upgrade && !isMajor && (
            <form method="POST" action="/api/actions/request-upgrade" class="ml-6 mt-1">
              <input type="hidden" name="service" value={s.name} />
              <input type="hidden" name="cmd" value={s.upgrade} />
              <input type="hidden" name="from_ver" value={s.current} />
              <input type="hidden" name="to_ver" value={s.latest || ''} />
              <button type="submit" class="text-xs px-2 py-0.5 rounded border bg-blue-950/40 text-blue-400 border-blue-800/40 hover:bg-blue-900/60 transition-colors">
                Schedule upgrade →{s.latest}
              </button>
            </form>
          )}
          {isMajor && badge && (
            <p class="ml-6 mt-1 text-xs text-red-400">⚠️ Major upgrade — manual backup + migration required</p>
          )}
        </li>
      );
    })}
  </ul>
</Section>
