---
import Section from '../Section.astro';

// Phase 7 wires real probes from Kuma/Langfuse/Coolify APIs.
// For now: curated list updated manually when services change.
const services = [
  { name: 'OpenClaw MCP',    url: 'api.ulcinno.me',           status: 'up',   icon: '🧠', note: null },
  { name: 'LiteLLM proxy',   url: 'litellm.ulcinno.me:4000',  status: 'up',   icon: '🤖', note: '3-tier fallback: Anthropic→DeepSeek→gpt-5-mini' },
  { name: 'Langfuse v3',     url: 'obs.ulcinno.me',           status: 'up',   icon: '📊', note: 'All LLM traces + cost/latency per agent' },
  { name: 'n8n',             url: 'api.ulcinno.me/n8n/',      status: 'up',   icon: '🔄', note: '9 workflows: briefs, alerts, grant-scan, KB bridge' },
  { name: 'Uptime Kuma',     url: 'kuma.ulcinno.me',          status: 'warn', icon: '🩺', note: 'Deployed + running — admin account + monitors pending setup' },
  { name: 'Coolify',         url: '204.168.150.251:8000',     status: 'warn', icon: '🚢', note: 'v4.1.0 running, 4 containers healthy — browser admin init pending' },
  { name: 'Supabase KB',     url: 'frsgzfzvdxswqjpdmcsd',    status: 'up',   icon: '🗄️', note: 'KB + dashboard + 60+ tables' },
  { name: 'Firecrawl Hobby', url: 'firecrawl.dev',            status: 'up',   icon: '🔥', note: '3K credits/mo — agents + Deki scraping' },
  { name: 'Better Stack',    url: 'geobim.betteruptime.com',  status: 'up',   icon: '⬆️', note: 'GeoBIM uptime + incident alerts' },
];

const statusColor = (s: string) =>
  s === 'up' ? 'text-green-400' : s === 'warn' ? 'text-yellow-400' : 'text-red-400';
const statusDot = (s: string) =>
  s === 'up' ? '🟢' : s === 'warn' ? '🟡' : '🔴';
---
<Section title="System Health" icon="⚙️" badge={services.filter(s => s.status === 'up').length} badgeColor="green">
  <ul class="space-y-1.5 text-sm">
    {services.map(s => (
      <li class="flex items-start gap-2 border-b border-gray-800/40 last:border-0 pb-1.5 last:pb-0">
        <span class="shrink-0 mt-0.5">{s.icon}</span>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-1">
            <span class="font-medium">{s.name}</span>
            <span class="text-xs">{statusDot(s.status)}</span>
          </div>
          {s.note && <p class="text-xs text-gray-500 line-clamp-1">{s.note}</p>}
          <p class="text-xs text-gray-700 font-mono">{s.url}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>
