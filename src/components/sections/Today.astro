---
import Section from '../Section.astro';
import { serverClient, MISSING_SERVICE_KEY } from '@lib/supabase';

const supabase = serverClient(Astro.locals);
const { data: items, error } = supabase
  ? await supabase
      .from('priority_queue')
      .select('id, title, description, scope, rank, is_blocker, blocked_by, project_id, due_date, completed_at')
      .in('scope', ['today', 'this_week'])
      .is('completed_at', null)
      .order('rank', { ascending: true })
      .limit(5)
  : { data: null, error: MISSING_SERVICE_KEY };

const todayItems = items?.filter(i => i.scope === 'today') || [];
const weekItems = items?.filter(i => i.scope === 'this_week') || [];
---
<Section title="Today + This Week" icon="🎯" badge={items?.length || 0} badgeColor="blue">
  {error && (
    <p class="text-xs text-accent-red">Supabase error: {error.message}</p>
  )}

  {(items?.length === 0 || !items) && !error && (
    <p class="text-sm text-gray-500 italic">No priorities set. Add via dashboard or pending_actions.</p>
  )}

  {todayItems.length > 0 && (
    <>
      <h3 class="text-xs uppercase tracking-wider text-gray-500 mb-2">Today</h3>
      <ul class="space-y-2 mb-4">
        {todayItems.map(item => (
          <li class="flex items-start gap-2 text-sm">
            <span class={item.is_blocker ? 'text-accent-red' : 'text-gray-400'} title={item.is_blocker ? 'blocker' : 'active'}>
              {item.is_blocker ? '🔴' : '🟢'}
            </span>
            <div class="flex-1 min-w-0">
              <p class="font-medium truncate">{item.title}</p>
              {item.blocked_by && <p class="text-xs text-gray-500">blocked: {item.blocked_by}</p>}
            </div>
            <form method="POST" action="/api/queue/complete" class="inline shrink-0">
              <input type="hidden" name="id" value={item.id} />
              <button type="submit" class="text-xs px-1.5 py-0.5 rounded border bg-gray-900/60 text-gray-500 border-gray-700/40 hover:text-green-400 hover:border-green-800/40 transition-colors" title="Mark done">
                ✓
              </button>
            </form>
          </li>
        ))}
      </ul>
    </>
  )}

  {weekItems.length > 0 && (
    <>
      <h3 class="text-xs uppercase tracking-wider text-gray-500 mb-2">This Week</h3>
      <ul class="space-y-2">
        {weekItems.map(item => (
          <li class="flex items-start gap-2 text-sm">
            <span class={item.is_blocker ? 'text-accent-red' : 'text-gray-400'}>
              {item.is_blocker ? '🔴' : '⚪'}
            </span>
            <div class="flex-1 min-w-0">
              <p class="truncate">{item.title}</p>
              {item.blocked_by && <p class="text-xs text-gray-500">blocked: {item.blocked_by}</p>}
            </div>
            <form method="POST" action="/api/queue/complete" class="inline shrink-0">
              <input type="hidden" name="id" value={item.id} />
              <button type="submit" class="text-xs px-1.5 py-0.5 rounded border bg-gray-900/60 text-gray-500 border-gray-700/40 hover:text-green-400 hover:border-green-800/40 transition-colors" title="Mark done">
                ✓
              </button>
            </form>
          </li>
        ))}
      </ul>
    </>
  )}
</Section>
